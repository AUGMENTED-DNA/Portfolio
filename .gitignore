node_modules/
# Local Claude settings stay ignored, but keep the committed scroll-craft skill
# (a parent dir can't be re-included, so ignore .claude/'s contents and carve out
# just this skill subtree).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/scroll-craft/
!.claude/skills/scroll-craft/**
data.json
.browser-sessions/
about.html
backlog.html
changelog.html
package-lock.json
.env
options/strategies/

# PAI infrastructure (machine-local, not portfolio code)
.commit-approved
.pai-server

# Work History index — derived SQLite artifact, regenerated by indexer.js
work-history.db

# Runtime logs — machine-local, regenerated, and noisy in a diff. Caught at the
# v4.16 commit when `git add -A` swept in watchdog.log, a crontab backup and
# five files under logs/ that had never been ignored.
logs/
*.log

# Generated by precompute.js every 4 hours — derived data, rebuilt from the
# session index. Committing it would churn history for something regenerable.
cache/
