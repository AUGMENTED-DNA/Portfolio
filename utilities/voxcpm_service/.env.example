# VoxCPM service configuration. Copy to .env and adjust. Never commit real secrets.

# Backend: "mock" (offline placeholder tone) or "voxcpm" (real model, needs GPU)
VOXCPM_BACKEND=mock

# Model id or local path for the real backend
VOXCPM_MODEL=openbmb/VoxCPM2

# Device override for the real backend: "", "cuda", "mps", or "cpu"
VOXCPM_DEVICE=

# Load the optional denoiser (real backend only)
VOXCPM_DENOISER=0

# Directory of named reference clips for the OpenAI `voice` parameter
# (e.g. VOXCPM_VOICES_DIR/alloy.wav -> voice "alloy"). Clone only voices you
# are authorised to use.
VOXCPM_VOICES_DIR=

VOXCPM_HOST=127.0.0.1
VOXCPM_PORT=8080
